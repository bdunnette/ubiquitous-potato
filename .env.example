# Django settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration (django-s3-sqlite)
# Default is True: uses django_s3_sqlite backend syncing with AWS S3.
# Set USE_S3_SQLITE=False for offline local development without AWS credentials.
USE_S3_SQLITE=True
SQLITE_S3_BUCKET=my-django-zappa-db-bucket
SQLITE_DB_NAME=db.sqlite3

# AWS Credentials (Optional for local development if using ~/.aws/credentials)
# When deployed to AWS Lambda, Lambda IAM execution role credentials are used automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Static files on S3 (Optional - uses WhiteNoise when False)
USE_S3_STATIC=False
AWS_STORAGE_BUCKET_NAME=my-django-zappa-static-bucket
